# ==============================================================================
# Bitka Data Platform - Environment Configuration
# ------------------------------------------------------------------------------
# WARNING: This file contains sensitive credentials. 
# DO NOT COMMIT this file to public version control systems (Git) in production.
# ==============================================================================

# --- Global Settings ---
APP_ENV=production
NETWORK_NAME=bitka-net

# ==============================================================================
# 1. SOURCE DATABASE (Operational Layer)
# ==============================================================================
# Hostname as recognized within the Docker network
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=password

# Logical Database Names (Reserved for microservices splitting)
AUTH_DB_NAME=bitka_auth
ACCOUNT_DB_NAME=bitka_account

# ==============================================================================
# 2. MICROSERVICES CONFIGURATION
# ==============================================================================
AUTH_PORT=8081
ACCOUNT_PORT=8082
AUTH_JWKS_URL=http://auth-service:8081/.well-known/jwks.json

# ==============================================================================
# 3. STREAMING INFRASTRUCTURE (Redpanda/Kafka)
# ==============================================================================
# Connectivity Strategy:
# Redpanda is configured with two listeners to support dual-access patterns.

# Internal: Used by services inside Docker (Debezium, Flink, Microservices)
KAFKA_BROKER_CONNECT=redpanda:9092

# External: Used by host machine scripts, local consumers, or external tools
KAFKA_BROKER_EXTERNAL=localhost:19092

# ==============================================================================
# 4. DATA WAREHOUSE (Analytical Layer)
# ==============================================================================
DW_HOST=warehouse
DW_DB_NAME=bitka_dw
DW_USER=warehouse_admin
DW_PASS=warehouse_password

# Port Mapping Strategy:
# - INTERNAL (5432): Standard Postgres port used inside the container network.
# - EXTERNAL (5433): Mapped to host machine to prevent conflict with Source DB (5432).
DW_PORT_EXTERNAL=5433
DW_PORT_INTERNAL=5432
{
  "name": "bitka-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "password",
    "database.dbname": "bitka_main",
    "topic.prefix": "bitka",
    "schema.include.list": "public",
    "table.include.list": "public.orders,public.matches,public.deposits,public.withdrawals,public.users,public.login_history,public.tickers,public.audit_logs",
    "plugin.name": "pgoutput",
    "decimal.handling.mode": "string"
  }
}